
# +----------------------------+
# | Core                       |
# +----------------------------+
NEXT_PUBLIC_APP_ENV=

NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# The frontend origin this API serves. Always trusted for credentialed
# (cookie-bearing) cross-origin requests.
APP_FRONTEND_URL=http://localhost:3000

# Optional. Comma-separated extra origins allowed to make credentialed requests
# to the API — set this when self-hosting on your own domains. When set, it
# replaces the built-in hosted defaults. Published pages on user custom domains
# do NOT need to be listed: they only call public, session-free endpoints.
# TRUSTED_ORIGINS=https://example.com,https://www.example.com

# A 32 byte key used to encrypt and decrypt data
ENCRYPTION_KEY=

# Tinybird - Used for analytics
NEXT_PUBLIC_TINYBIRD_TRACKER_TOKEN=

# Resend - Used for emails
RESEND_API_KEY=

# Sentry
NEXT_PUBLIC_SENTRY_DSN=

# AWS - Used for uploading assets to S3
AWS_ACCESS_KEY_ID=
AWS_REGION=
AWS_SECRET_ACCESS_KEY=

# Google - Used for OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Twitter - Used for OAuth
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_CHALLENGE=
TWITTER_CALLBACK_URL=

DATABASE_URL=postgresql://glow_user:KGfUZosCOm@localhost:5432/glow_development
DIRECT_URL=postgresql://glow_user:KGfUZosCOm@localhost:5432/glow_development

# Stripe - Used for payments
STRIPE_API_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Google Search Console HTML-tag verification token (optional; omit to skip the meta tag)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# +----------------------------+
# | Integrations               |
# +----------------------------+
GITHUB_AUTH_TOKEN=

INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CALLBACK_URL=

SPOTIFY_CLIENT_SECRET=
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=

NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# +----------------------------+
# | App Review User            |
# +----------------------------+
TMP_APP_REVIEW_USER_ID=
TMP_APP_REVIEW_USER_PASSWORD=
TMP_APP_REVIEW_USER_EMAIL=
