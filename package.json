{
  "name": "@trylinky/linky",
  "version": "1.0.0",
  "private": true,
  "repository": "https://github.com/trylinky/linky.git",
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "eslint": "^9.14.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "prettier": "^3.3.3",
    "tslib": "^2.8.1",
    "typescript": "5.6.3"
  },
  "dependencies": {
    "turbo": "^2.3.3"
  },
  "scripts": {
    "test": "turbo test",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "dev": "turbo dev",
    "dev:push": "pnpm --filter @trylinky/db push",
    "dev:seed": "pnpm --filter @trylinky/db seed",
    "dev:reset": "dotenvx run -f .env.local -- sh -c 'psql \"$DIRECT_URL\" -c \"DROP SCHEMA public CASCADE; CREATE SCHEMA public;\"' && pnpm dev:push && pnpm dev:seed"
  },
  "pnpm": {
    "overrides": {
      "react-is": "^19.0.0-rc-69d4b800-20241021"
    }
  },
  "packageManager": "pnpm@9.15.0"
}
